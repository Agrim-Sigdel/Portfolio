# Supabase Edge Function secrets (for notify-contact and send-reply).
#
# HOW TO USE:
#   1. cp supabase/.env.example supabase/.env
#   2. fill in the real values in supabase/.env  (that file is gitignored)
#   3. push them to Supabase:
#        supabase secrets set --env-file supabase/.env
#
# These live on Supabase's servers, NOT in your app bundle. Do not add a VITE_
# prefix and do not put them in .env.local.

# From resend.com → API Keys. Rotate if it was ever exposed.
RESEND_API_KEY=

# Where the notification email is sent (your inbox).
NOTIFY_TO=sigdelagrim35@gmail.com

# Sender for the "you have a new message" notification. Must be a Resend-verified
# domain; onboarding@resend.dev works for testing but only delivers to the address
# that owns the Resend account.
NOTIFY_FROM="Agrim Sigdel <contact@agrimsigdel.com.np>"

# Sender for replies you send from /admin. Visitors see this address and their
# replies come back to it, so keep it a real, monitored mailbox.
REPLY_FROM="Agrim Sigdel <contact@agrimsigdel.com.np>"

# Any long random string you invent. Must match the "Authorization: Bearer <...>"
# header you set on the Database Webhook.
WEBHOOK_SECRET=
